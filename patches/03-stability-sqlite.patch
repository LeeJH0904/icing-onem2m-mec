+/* Heap copy of a TEXT cell (NUL-terminated). Caller frees. */
+static char *sqlite_cell_text(sqlite3_stmt *stmt, int col)
+{
+    int n = sqlite3_column_bytes(stmt, col);
+    const unsigned char *t = sqlite3_column_text(stmt, col);
+    char *p = malloc((size_t)(n > 0 ? n : 0) + 1);
+    if (!p)
+        return NULL;
+    if (t && n > 0)
+        memcpy(p, t, (size_t)n);
+    p[n > 0 ? n : 0] = '\0';
+    return p;
+}
